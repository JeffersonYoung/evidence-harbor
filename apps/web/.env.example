# Server-only. Never prefix API_TOKEN with NEXT_PUBLIC_.
API_BASE_URL=http://127.0.0.1:8000
# Keep false for multi-user login mode. Never expose single-user mode publicly.
SINGLE_USER_MODE=false
# Only used when SINGLE_USER_MODE=true and UI is bound to loopback.
# API_TOKEN=replace-with-same-token-as-backend
