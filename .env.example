# Copy to .env. Never commit credentials.
# Required Compose database secrets. Set three distinct private values before startup.
POSTGRES_ADMIN_PASSWORD=
RESEARCH_DB_PASSWORD=
TEMPORAL_DB_PASSWORD=
# Optional server token for explicitly configured service clients; account mode needs none.
API_TOKEN=
# Optional JSON mapping token to {"workspace_id":"default","role":"researcher"}.
API_TOKENS_JSON=
WORKSPACE_ID=default
LOCAL_WORKER=false
OBJECTS_DIR=/data/objects
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=research-workspace
API_BASE_URL=http://api:8000
# External services are opt-in; offline extraction is the default.
# Team account mode is default; create accounts with python -m backend.auth USER.
SINGLE_USER_MODE=false
# Optional PostgreSQL vector tables are installed by migration when enabled.
ENABLE_PGVECTOR=true
# External providers: all disabled until these explicit operator gates are configured.
ENABLE_EXTERNAL_PROVIDERS=false
EXTERNAL_EVIDENCE_POLICY=deny
EXTERNAL_ALLOWED_CLASSIFICATIONS=public
ALLOW_SENSITIVE_EXTERNAL_DATA=false
