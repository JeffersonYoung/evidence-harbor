[
  {
    "name": "create_evidence",
    "description": "Register an exact substring from a previously read block; server verifies it.",
    "inputSchema": {
      "properties": {
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "block_id": {
          "title": "Block Id",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "start_offset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Offset"
        }
      },
      "required": [
        "project_id",
        "block_id",
        "quote"
      ],
      "title": "create_evidenceArguments",
      "type": "object"
    }
  },
  {
    "name": "get_evidence",
    "description": "Verify and read the exact stored quote and immutable capture/block locator.",
    "inputSchema": {
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        }
      },
      "required": [
        "evidence_id"
      ],
      "title": "get_evidenceArguments",
      "type": "object"
    }
  },
  {
    "name": "get_ingestion_status",
    "description": "Read ingestion state. A failed activity attempt is not a terminal durable workflow.\n\n    Temporal calls include live execution status; unknown workflow state never proves completion.\n    Only succeeded processing supplies read-ready documents/evidence; archived bytes alone do not.\n    ",
    "inputSchema": {
      "properties": {
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        }
      },
      "required": [
        "operation_id"
      ],
      "title": "get_ingestion_statusArguments",
      "type": "object"
    }
  },
  {
    "name": "get_project_context",
    "description": "Read bounded project metadata, report baseline and per-collection pages, never full document text.\n\n    Each collection has counts and a next_offset. Use read_document with the returned\n    report/document version to inspect actual content; metadata does not count as reading.\n    ",
    "inputSchema": {
      "properties": {
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "offset": {
          "default": 0,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "limit": {
          "default": 20,
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "project_id"
      ],
      "title": "get_project_contextArguments",
      "type": "object"
    }
  },
  {
    "name": "ingest_source",
    "description": "Submit a public URL to the common archive, preprocessing and publication pipeline.",
    "inputSchema": {
      "properties": {
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "url"
      ],
      "title": "ingest_sourceArguments",
      "type": "object"
    }
  },
  {
    "name": "intake_discovered_works",
    "description": "Intake up to 20 scholarly works/observations through the common deduplication API.\n\n    DOI/arXiv/title-author identity and immutable observations are domain-validated.\n    Maximum serialized payload 256000 bytes. Metadata/abstracts create no ready document\n    or fulltext reading. This requires the API researcher role, not editor authority.\n    ",
    "inputSchema": {
      "$defs": {
        "WorkInput": {
          "additionalProperties": false,
          "properties": {
            "title": {
              "maxLength": 2000,
              "minLength": 1,
              "title": "Title",
              "type": "string"
            },
            "authors": {
              "items": {
                "type": "string"
              },
              "maxItems": 200,
              "title": "Authors",
              "type": "array"
            },
            "doi": {
              "anyOf": [
                {
                  "maxLength": 300,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Doi"
            },
            "arxiv_id": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Arxiv Id"
            },
            "year": {
              "anyOf": [
                {
                  "maximum": 2200,
                  "minimum": 1000,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Year"
            },
            "source_url": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Source Url"
            },
            "abstract": {
              "default": "",
              "maxLength": 100000,
              "title": "Abstract",
              "type": "string"
            },
            "access_status": {
              "default": "unknown",
              "enum": [
                "unknown",
                "open_access",
                "restricted",
                "unavailable"
              ],
              "title": "Access Status",
              "type": "string"
            },
            "metadata": {
              "additionalProperties": true,
              "title": "Metadata",
              "type": "object"
            }
          },
          "required": [
            "title"
          ],
          "title": "WorkInput",
          "type": "object"
        }
      },
      "properties": {
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/WorkInput"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "project_id",
        "items"
      ],
      "title": "intake_discovered_worksArguments",
      "type": "object"
    }
  },
  {
    "name": "link_scholarly_reading",
    "description": "Link an acquired source via the same provenance/integrity/scope-checked reading API.\n\n    fulltext_reviewed attests the saved artifact contains full text, not completion of\n    reading. State the actual inspected sections/window in review_note. Known abstracts\n    cannot become fulltext and metadata alone cannot establish a reading link.\n    ",
    "inputSchema": {
      "properties": {
        "work_id": {
          "title": "Work Id",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "content_scope": {
          "enum": [
            "abstract",
            "fulltext"
          ],
          "title": "Content Scope",
          "type": "string"
        },
        "review_note": {
          "maxLength": 10000,
          "minLength": 5,
          "title": "Review Note",
          "type": "string"
        },
        "fulltext_reviewed": {
          "default": false,
          "title": "Fulltext Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "work_id",
        "document_id",
        "content_scope",
        "review_note"
      ],
      "title": "link_scholarly_readingArguments",
      "type": "object"
    }
  },
  {
    "name": "list_discovered_works",
    "description": "List bounded scholarly metadata and scope/readiness, never full abstracts or proof of reading.\n\n    Follow next_offset. Read individual work/record windows for provenance and reviews.\n    ",
    "inputSchema": {
      "properties": {
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "offset": {
          "default": 0,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "limit": {
          "default": 20,
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "project_id"
      ],
      "title": "list_discovered_worksArguments",
      "type": "object"
    }
  },
  {
    "name": "propose_research_update",
    "description": "Propose a report revision. Each claim needs text and verified evidence_ids.\n\n    Include target_document_id and base_version together to revise an existing report.\n    Every claims[i].text must appear verbatim in content; paraphrased-only claim lists are rejected.\n    This tool never publishes; the API rejects stale baselines and invalid citations.\n    ",
    "inputSchema": {
      "properties": {
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "claims": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Claims",
          "type": "array"
        },
        "target_document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Document Id"
        },
        "base_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Version"
        }
      },
      "required": [
        "project_id",
        "title",
        "content",
        "claims"
      ],
      "title": "propose_research_updateArguments",
      "type": "object"
    }
  },
  {
    "name": "read_discovered_work",
    "description": "Read reviewed display metadata, an abstract window and paginated immutable record IDs.\n\n    Each collection has pages/next_offset. Read observation, reading and metadata_review\n    records progressively by ID. Abstract inspection never certifies full-paper reading.\n    ",
    "inputSchema": {
      "properties": {
        "work_id": {
          "title": "Work Id",
          "type": "string"
        },
        "offset": {
          "default": 0,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "limit": {
          "default": 10,
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "abstract_start": {
          "default": 0,
          "maximum": 100000,
          "minimum": 0,
          "title": "Abstract Start",
          "type": "integer"
        },
        "abstract_limit": {
          "default": 2000,
          "maximum": 8000,
          "minimum": 1,
          "title": "Abstract Limit",
          "type": "integer"
        }
      },
      "required": [
        "work_id"
      ],
      "title": "read_discovered_workArguments",
      "type": "object"
    }
  },
  {
    "name": "read_document",
    "description": "Read a bounded document/version window or structural block (default 8000 code points).\n\n    Pin returned version for subsequent pages; pass reading_range.next_offset as start.\n    start is document-absolute, including with block_id; omission starts at that block.\n    Canonical block offsets/IDs stay fixed. Cropped text has its own content_hash;\n    canonical_content_hash identifies the full block. For create_evidence start_offset,\n    add text_range.block_start_offset to the quote's offset within returned block text.\n    All offsets count Unicode code points, not bytes or UTF-16 units.\n    ",
    "inputSchema": {
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "start": {
          "anyOf": [
            {
              "maximum": 4000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "limit": {
          "default": 8000,
          "maximum": 32000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "block_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Id"
        }
      },
      "required": [
        "document_id"
      ],
      "title": "read_documentArguments",
      "type": "object"
    }
  },
  {
    "name": "read_scholarly_record",
    "description": "Read a Unicode-code-point window of an immutable scholarly record's canonical JSON.\n\n    Concatenate text windows via reading_range.next_offset to reconstruct full JSON.\n    record_sha256 hashes the complete canonical JSON; text_sha256 hashes this window.\n    Observation metadata is audit data, never authority or an evidence-readiness grant.\n    ",
    "inputSchema": {
      "properties": {
        "work_id": {
          "title": "Work Id",
          "type": "string"
        },
        "record_kind": {
          "enum": [
            "observation",
            "reading",
            "metadata_review"
          ],
          "title": "Record Kind",
          "type": "string"
        },
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "start": {
          "default": 0,
          "maximum": 2000000,
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "limit": {
          "default": 2000,
          "maximum": 16000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "work_id",
        "record_kind",
        "record_id"
      ],
      "title": "read_scholarly_recordArguments",
      "type": "object"
    }
  },
  {
    "name": "record_scholarly_observation",
    "description": "Append a bounded immutable observation to an existing work using its stable identity.\n\n    Preserve original DOI/arXiv/title-author fields and provenance. Screening, QA\n    adjudication or substantive-review notes belong in metadata (for example\n    title_abstract_screen, title_abstract_screen_adjudication, substantive_review).\n    The server rejects identity mismatches. Notes never override canonical metadata,\n    publish reports or certify a full-paper read. Exact repeated payloads deduplicate.\n    ",
    "inputSchema": {
      "$defs": {
        "WorkInput": {
          "additionalProperties": false,
          "properties": {
            "title": {
              "maxLength": 2000,
              "minLength": 1,
              "title": "Title",
              "type": "string"
            },
            "authors": {
              "items": {
                "type": "string"
              },
              "maxItems": 200,
              "title": "Authors",
              "type": "array"
            },
            "doi": {
              "anyOf": [
                {
                  "maxLength": 300,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Doi"
            },
            "arxiv_id": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Arxiv Id"
            },
            "year": {
              "anyOf": [
                {
                  "maximum": 2200,
                  "minimum": 1000,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Year"
            },
            "source_url": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Source Url"
            },
            "abstract": {
              "default": "",
              "maxLength": 100000,
              "title": "Abstract",
              "type": "string"
            },
            "access_status": {
              "default": "unknown",
              "enum": [
                "unknown",
                "open_access",
                "restricted",
                "unavailable"
              ],
              "title": "Access Status",
              "type": "string"
            },
            "metadata": {
              "additionalProperties": true,
              "title": "Metadata",
              "type": "object"
            }
          },
          "required": [
            "title"
          ],
          "title": "WorkInput",
          "type": "object"
        }
      },
      "properties": {
        "work_id": {
          "title": "Work Id",
          "type": "string"
        },
        "observation": {
          "$ref": "#/$defs/WorkInput"
        }
      },
      "required": [
        "work_id",
        "observation"
      ],
      "title": "record_scholarly_observationArguments",
      "type": "object"
    }
  },
  {
    "name": "search_library",
    "description": "Find published local evidence blocks; results retain immutable version IDs.",
    "inputSchema": {
      "properties": {
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "query": {
          "title": "Query",
          "type": "string"
        },
        "limit": {
          "default": 20,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "project_id",
        "query"
      ],
      "title": "search_libraryArguments",
      "type": "object"
    }
  },
  {
    "name": "search_web",
    "description": "Find external leads using the configured search service, not report evidence.",
    "inputSchema": {
      "properties": {
        "query": {
          "title": "Query",
          "type": "string"
        },
        "limit": {
          "default": 5,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "query"
      ],
      "title": "search_webArguments",
      "type": "object"
    }
  }
]
